DATABASE_URL=postgresql://postgres:your_password@localhost:5432/tram_may_anh
PORT=3000

# Optional: enables AI-written replies in the device finder.
# Without this key, the chat still recommends real products from PostgreSQL.
# Trợ lý AI (tùy chọn). Dùng được mọi API tương thích OpenAI, ví dụ:
#   Google Gemini (miễn phí): AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   Groq (miễn phí):          AI_BASE_URL=https://api.groq.com/openai/v1
#   OpenRouter (model :free): AI_BASE_URL=https://openrouter.ai/api/v1
#   Ollama chạy trên máy:     AI_BASE_URL=http://localhost:11434/v1  (AI_API_KEY để trống)
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# Model dự phòng khi model chính quá tải (503), cách nhau bằng dấu phẩy:
AI_FALLBACK_MODELS=
# Mức suy nghĩ cho model có reasoning (Gemini: low giúp trả lời nhanh). Để trống với gpt-4.1:
AI_REASONING_EFFORT=
# Cấu hình cũ, chỉ dùng khi không đặt AI_API_KEY/AI_BASE_URL:
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Bắt buộc để nhận hồ sơ CCCD: khóa 32 byte, tạo bằng lệnh
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
KYC_ENCRYPTION_KEY=

# Email: log = chỉ ghi nhận mô phỏng, smtp = gửi thật
NOTIFY_EMAIL_PROVIDER=log
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Trạm Máy Ảnh <no-reply@trammayanh.vn>
APP_URL=http://localhost:5173

# SMS: log = chỉ ghi nhận mô phỏng, twilio = gửi thật
NOTIFY_SMS_PROVIDER=log
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Bảo vệ route cron trên Vercel
CRON_SECRET=
