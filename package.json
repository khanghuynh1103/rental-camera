{
  "name": "tram-may-anh",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"node --watch server/index.js\" \"vite\"",
    "build": "vite build",
    "start": "npm run build && node server/index.js",
    "migrate": "node server/migrate-schema.js",
    "migrate:schema": "node server/migrate-schema.js",
    "migrate:products": "node server/migrate-products.js",
    "seed:roles": "node server/seed-roles.js",
    "setup": "npm run migrate && npm run migrate:products && npm run seed:roles",
    "check": "eslint .",
    "format": "prettier --write server api src",
    "format:check": "prettier --check server api src",
    "test": "npm run test:unit",
    "test:unit": "node --test \"server/tests/*.test.js\"",
    "test:workflow": "node server/test-workflow.js"
  },
  "dependencies": {
    "@ant-design/icons": "6.3.4",
    "antd": "6.6.8",
    "cookie-parser": "1.4.7",
    "dotenv": "18.0.7",
    "express": "5.2.1",
    "nodemailer": "10.3.1",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.5",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.12.0",
    "prettier": "3.9.10",
    "vite": "8.3.1"
  },
  "engines": {
    "node": ">=20"
  }
}
